# Copy to .env and fill in. Both keys are free and optional (code runs without them at lower limits).
# Census: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# BLS v2: https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Contact email BLS requires in the User-Agent for download.bls.gov (sent to bls.gov only)
BLS_CONTACT_EMAIL=
